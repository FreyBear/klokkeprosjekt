{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Sketch (Arduino CLI)",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "esp32:esp32:esp32",
        "--build-path",
        "${workspaceFolder}/build",
        "${workspaceFolder}/sketch"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
